<Window x:Class="egzamin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:egzamin"
        mc:Ignorable="d"
        Background="Cornsilk"
        Title="Wzornik kolorów RGB. Wykonał: 18" Height="500" Width="800">
    <StackPanel Orientation="Vertical" 
                HorizontalAlignment="Center">
        <Label x:Name="canvas" 
               Width="670" 
               Height="100" 
               Background="White"
               Margin="0, 30, 0, 20"/>
        <Label Content="Dobierz kolor suwakami i zapisz przyciskiem: " />
        <StackPanel Margin="0, 15, 0, 15"
                    Orientation="Horizontal" >
            <Label Content="R"
                   Margin="0, 0, 15, 0"/>
            <Slider x:Name="sliderR" 
                    Maximum="255"
                    Width="600"
                    Value="255"
                    ValueChanged="sliderR_ValueChanged" />
            <Label x:Name="rVal"
                   Margin="15, 0, 0, 0"
                   Content="255" />
        </StackPanel>
        <StackPanel Margin="0, 15, 0, 15"
            Orientation="Horizontal" >
            <Label Content="R"
           Margin="0, 0, 15, 0"/>
            <Slider x:Name="sliderG" 
            Maximum="255"
            Width="600"
                    ValueChanged="sliderG_ValueChanged"
            Value="255" />
            <Label x:Name="gVal"
           Margin="15, 0, 0, 0"
           Content="255" />
        </StackPanel>
        <StackPanel Margin="0, 15, 0, 15"
            Orientation="Horizontal" >
            <Label Content="R"
           Margin="0, 0, 15, 0"/>
            <Slider x:Name="sliderB" 
            Maximum="255"
            Width="600"
            ValueChanged="sliderB_ValueChanged"
            Value="255" />
            <Label x:Name="bVal"
           Margin="15, 0, 0, 0"
           Content="255" />
        </StackPanel>
        <Button x:Name="btnDwnl"
                Background="Peru"
                Width="150"
                Height="30"
                Content="Pobierz"
                Click="btnDwnl_Click" />
        <Label x:Name="canvasLabel"
               Background="White"
               Width="150"
               Margin="0, 15, 0, 0"
               Height="30"
               Content="255, 255, 255" />
    </StackPanel>
</Window>
